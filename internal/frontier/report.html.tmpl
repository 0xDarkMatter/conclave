<!DOCTYPE html>
<!--
  Conclave frontier report (ADR-018), rendered by internal/frontier/html.go.
  GUARD: one self-contained file. Every asset is inline and nothing is fetched
  (no CDN, no webfont, no remote image): it must work offline and from file://.
  The only URLs are the sources' own anchors in the sources section.
-->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<style>
:root {
  --font: "Inter", "Segoe UI Variable", "Segoe UI", system-ui, -apple-system, "Helvetica Neue", sans-serif;
  --bg: #f7f8fa;
  --surface: #ffffff;
  --text: #1b1f24;
  --muted: #5d6673;
  --line: #d9dee5;
  --grid: #e8ebf0;
  --accent: #1f5fbf;
  --accent-soft: #c9d9f2;
  --dom: #7c8694;
  --warn-bg: #fff5d6;
  --warn-text: #6b4e00;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #111418;
    --surface: #191d23;
    --text: #e6e9ee;
    --muted: #9aa3af;
    --line: #2d333c;
    --grid: #232830;
    --accent: #7fb0ff;
    --accent-soft: #24406b;
    --dom: #8a94a3;
    --warn-bg: #3a3014;
    --warn-text: #f0d68a;
  }
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font);
  font-size: 15px;
  line-height: 1.5;
}
button, select, input, textarea { font-family: var(--font); font-size: inherit; color: inherit; }
main { max-width: 980px; margin: 0 auto; padding: 24px 16px 48px; }
h1 { font-size: 1.5rem; margin: 0 0 4px; line-height: 1.25; }
h2 { font-size: 1.1rem; margin: 32px 0 8px; }
p { margin: 0 0 12px; }
.sub, .note { color: var(--muted); }
.card { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 12px; }
.chart { display: block; width: 100%; height: auto; }
.chart text { font-family: var(--font); fill: var(--text); font-size: 12px; }
.chart .tick { fill: var(--muted); font-size: 11px; }
.chart .axis { fill: var(--muted); font-size: 12px; }
.chart .empty { fill: var(--muted); }
.chart .grid line { stroke: var(--grid); stroke-width: 1; }
.chart .step { fill: none; stroke: var(--accent); stroke-width: 2; }
.chart .pt circle, .chart .pt path { stroke-width: 1.5; }
.chart .front circle, .chart .front path { fill: var(--accent); stroke: var(--accent); }
.chart .dom circle, .chart .dom path { fill: var(--surface); stroke: var(--dom); }
.chart .labels text { font-size: 11px; }
.chart.hide-dom .dom { display: none; }
.legend { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 8px 0 0; padding: 0; list-style: none; color: var(--muted); font-size: 13px; }
.legend li { display: flex; align-items: center; gap: 6px; }
.legend svg { width: 16px; height: 16px; flex: none; }
.legend .front { fill: var(--accent); stroke: var(--accent); }
.legend .dom { fill: var(--surface); stroke: var(--dom); stroke-width: 1.5; }
.legend .step { fill: none; stroke: var(--accent); stroke-width: 2; }
.toggle { display: inline-flex; align-items: center; gap: 6px; margin-top: 8px; color: var(--muted); font-size: 13px; }
.tablewrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 14px; }
th, td { padding: 6px 8px; border-bottom: 1px solid var(--line); text-align: left; white-space: nowrap; }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
th button { background: none; border: 0; padding: 0; font-weight: 600; cursor: pointer; text-align: inherit; }
th button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
th[aria-sort="ascending"] button::after { content: " \2191"; }
th[aria-sort="descending"] button::after { content: " \2193"; }
tr.on-frontier td:first-child { font-weight: 600; }
.unscored { columns: 2 220px; margin: 0; padding-left: 18px; }
.warn { background: var(--warn-bg); color: var(--warn-text); border-radius: 6px; padding: 6px 10px; margin-top: 6px; }
#sources dl { margin: 0; }
#sources dt { font-weight: 600; margin-top: 12px; }
#sources dd { margin: 2px 0 0; color: var(--muted); overflow-wrap: anywhere; }
#sources a { color: var(--accent); }
footer { margin-top: 32px; color: var(--muted); font-size: 13px; }
</style>
</head>
<body>
<main>
<h1>{{.Title}}</h1>
<p class="sub">{{.Subtitle}}</p>
<p class="note">Every score comes from a named external source (listed at the end) with its own snapshot date. Conclave runs no evaluations, and a model with no external score is listed as unscored, never estimated.</p>

<h2>Score vs cost</h2>
<div class="card">
{{.PriceChart}}
<ul class="legend">
<li><svg viewBox="0 0 16 16" aria-hidden="true"><circle class="front" cx="8" cy="8" r="5"/></svg>On the frontier (filled)</li>
<li><svg viewBox="0 0 16 16" aria-hidden="true"><circle class="dom" cx="8" cy="8" r="5"/></svg>Dominated (hollow)</li>
<li><svg viewBox="0 0 16 16" aria-hidden="true"><path class="dom" d="M8 1 L15 8 L8 15 L1 8Z"/></svg>Self-reported (diamond)</li>
<li><svg viewBox="0 0 16 16" aria-hidden="true"><path class="step" d="M1 12 H8 V4 H15"/></svg>Frontier step line</li>
</ul>
<label class="toggle"><input type="checkbox" data-hide-dom> Hide dominated models</label>
{{if .ZeroCostNote}}<p class="note">{{.ZeroCostNote}}</p>{{end}}
{{range .FreeDaily}}<p class="note">Free daily allocation, {{.Allocation}}: {{.Models}}. Calls inside it are billed $0; the plotted cost is the metered list price, which applies once it is spent (ADR-019).</p>
{{end}}</div>
<p class="note">{{.BasisNote}}</p>
{{if .LatencyChart}}
<h2>Score vs median latency</h2>
<div class="card">
{{.LatencyChart}}
<p class="note">Filled markers are on the price frontier above; latency is the source's published median per call.</p>
</div>
{{end}}

<h2>All models</h2>
<div class="card tablewrap">
<table id="points">
<caption class="note">Click a column header to sort. Cost is {{.CostLabel}}.</caption>
<thead><tr>
<th scope="col" data-type="text"><button type="button">Model</button></th>
<th scope="col" class="num" data-type="num"><button type="button">Score</button></th>
<th scope="col" class="num" data-type="num"><button type="button">Cost</button></th>
<th scope="col" data-type="text"><button type="button">Cost basis</button></th>
<th scope="col" class="num" data-type="num"><button type="button">Latency</button></th>
<th scope="col" class="num" data-type="num"><button type="button">ECE</button></th>
<th scope="col" data-type="text"><button type="button">Self-reported</button></th>
<th scope="col" data-type="text"><button type="button">Frontier</button></th>
</tr></thead>
<tbody>
{{range .Rows}}<tr{{if .OnFrontier}} class="on-frontier"{{end}}>
<td data-v="{{.Name}}" title="{{.ID}}">{{.Name}}</td>
<td class="num" data-v="{{.ScoreKey}}">{{.Score}}</td>
<td class="num" data-v="{{.CostKey}}">{{.Cost}}</td>
<td data-v="{{.Basis}}">{{.Basis}}</td>
<td class="num" data-v="{{.LatencyKey}}">{{.Latency}}</td>
<td class="num" data-v="{{.ECEKey}}">{{.ECE}}</td>
<td data-v="{{if .SelfReported}}yes{{else}}no{{end}}">{{if .SelfReported}}yes{{else}}no{{end}}</td>
<td data-v="{{if .OnFrontier}}yes{{else}}no{{end}}">{{if .OnFrontier}}yes{{else}}no{{end}}</td>
</tr>
{{end}}</tbody>
</table>
</div>

<h2>Unscored</h2>
{{if .Unscored}}<p class="note">No external source scores these models on this axis, so they are not plotted.</p>
<ul class="unscored">
{{range .Unscored}}<li>{{.}}</li>
{{end}}</ul>{{else}}<p class="note">Every model has an external score.</p>{{end}}

<section id="sources">
<h2>Sources</h2>
<dl>
{{range .Sources}}<dt>{{.Name}}</dt>
{{if .URL}}<dd><a href="{{.URL}}">{{.URL}}</a></dd>{{end}}
{{if .AsOf}}<dd>As of {{.AsOf}}</dd>{{end}}
{{if .Edition}}<dd>Edition {{.Edition}}</dd>{{end}}
{{if .Citation}}<dd>{{.Citation}}</dd>{{end}}
{{if .Error}}<dd class="warn">Unavailable: {{.Error}}</dd>{{end}}
{{if .Warning}}<dd class="warn">Warning: {{.Warning}}</dd>{{end}}
{{end}}</dl>
</section>

<footer>Generated by <code>conclave models --frontier</code>. ADR-018: frontiers come from external, edition-pinned sources only.</footer>
</main>
<script>
// Hover tooltips are the SVG <title> elements (no script needed). This only
// sorts the table and toggles dominated markers.
(function () {
  var table = document.getElementById("points");
  if (table) {
    var heads = table.tHead.rows[0].cells;
    Array.prototype.forEach.call(heads, function (th, col) {
      th.querySelector("button").addEventListener("click", function () {
        var asc = th.getAttribute("aria-sort") !== "ascending";
        Array.prototype.forEach.call(heads, function (h) { h.removeAttribute("aria-sort"); });
        th.setAttribute("aria-sort", asc ? "ascending" : "descending");
        var num = th.getAttribute("data-type") === "num";
        var body = table.tBodies[0];
        var rows = Array.prototype.slice.call(body.rows);
        rows.sort(function (a, b) {
          var x = a.cells[col].getAttribute("data-v"), y = b.cells[col].getAttribute("data-v");
          if (num) {
            // Unknown values sort last in both directions.
            if (x === "" || y === "") { return (x === "") - (y === ""); }
            return asc ? x - y : y - x;
          }
          return asc ? x.localeCompare(y) : y.localeCompare(x);
        });
        rows.forEach(function (r) { body.appendChild(r); });
      });
    });
  }
  Array.prototype.forEach.call(document.querySelectorAll("[data-hide-dom]"), function (box) {
    box.addEventListener("change", function () {
      Array.prototype.forEach.call(document.querySelectorAll("svg.chart"), function (svg) {
        svg.classList.toggle("hide-dom", box.checked);
      });
    });
  });
})();
</script>
</body>
</html>
